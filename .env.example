# Advanced Resume Ranker Pro - Environment Variables
# Copy this file to .env and fill in your actual values

# Required: OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Database Configuration
DATABASE_URL=sqlite:///./resume_ranker.db

# Optional: Email Configuration (for interview scheduling)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Optional: Application Settings
DEBUG=False
APP_NAME=Advanced Resume Ranker Pro
APP_VERSION=2.0.0

# Optional: AI Model Settings
DEFAULT_MODEL=gpt-4o
TEMPERATURE=0.3
MAX_TOKENS=4000

# Optional: File Processing
MAX_FILE_SIZE_MB=50

# Optional: Business Intelligence
ENABLE_ANALYTICS=True
ENABLE_BIAS_DETECTION=True

# Optional: API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_TITLE=Advanced Resume Ranker API
API_VERSION=2.0.0